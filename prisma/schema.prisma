generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  email        String        @unique
  passwordHash String

  wallet       Wallet?
  bets         Bet[]
  transactions Transaction[]
  sessions     Session[]
  avatar       UserAvatar?
  hostedRooms  GameRoom[]    @relation("HostedRooms")
  roomMemberships RoomPlayer[]
  roomBets     RoomBet[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model UserAvatar {
  userId    String   @id
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(10000) @db.Decimal(12, 2)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GameRound {
  id        String   @id @default(cuid())
  dice1     Int
  dice2     Int
  total     Int
  result    BetType

  bets      Bet[]

  createdAt DateTime @default(now())
}

model Bet {
  id        String   @id @default(cuid())

  userId    String
  roundId   String

  type      BetType
  amount    Decimal  @db.Decimal(12, 2)
  won       Boolean
  profit    Decimal  @db.Decimal(12, 2)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  round     GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([roundId])
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String

  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  balanceBefore Decimal         @db.Decimal(12, 2)
  balanceAfter  Decimal         @db.Decimal(12, 2)
  description   String

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime         @default(now())

  @@index([userId])
}

model GameRoom {
  id             String     @id @default(cuid())
  code           String     @unique
  name           String
  hostUserId     String
  status         RoomStatus @default(OPEN)
  bettingOpen    Boolean    @default(false)
  minBet         Int        @default(1)
  maxBet         Int        @default(10000)
  maxPlayers     Int        @default(6)
  roundSeconds   Int        @default(30)
  host           User       @relation("HostedRooms", fields: [hostUserId], references: [id], onDelete: Cascade)
  players        RoomPlayer[]
  rounds         RoomRound[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([hostUserId])
  @@index([status])
}

model RoomPlayer {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())
  removedAt DateTime?
  room     GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model RoomRound {
  id        String          @id @default(cuid())
  roomId    String
  number    Int
  status    RoomRoundStatus @default(BETTING)
  dice1     Int?
  dice2     Int?
  total     Int?
  result    BetType?
  endsAt    DateTime
  settledAt DateTime?
  pausedRemainingSeconds Int?
  createdAt DateTime        @default(now())
  room      GameRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bets      RoomBet[]

  @@unique([roomId, number])
  @@index([roomId, status])
}

model RoomBet {
  id        String    @id @default(cuid())
  roundId   String
  userId    String
  type      BetType
  amount    Decimal   @db.Decimal(12, 2)
  won       Boolean?
  profit    Decimal?  @db.Decimal(12, 2)
  cancelled Boolean   @default(false)
  settledAt DateTime?

  createdAt DateTime  @default(now())
  round     RoomRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@index([userId])
  @@index([roundId, settledAt])
}

enum BetType {
  UP
  SEVEN
  DOWN
}

enum TransactionType {
  INITIAL_BALANCE
  BET
  WIN
  ADMIN_ADJUSTMENT
}

enum RoomStatus {
  WAITING
  OPEN
  PAUSED
  CLOSED
}

enum RoomRoundStatus {
  BETTING
  ROLLED
  CANCELLED
}
